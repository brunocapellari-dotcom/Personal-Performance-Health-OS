# Copy to .env locally. Never commit real values.
HEALTHOS_ENV=development
HEALTHOS_DATABASE_URL=postgresql+psycopg://healthos:change-me@localhost:5432/healthos

# Production requires independent high-entropy values.
POSTGRES_PASSWORD=replace-with-random-password
HEALTHOS_BOOTSTRAP_TOKEN=replace-with-random-token-at-least-32-characters
HEALTHOS_JWT_SECRET=replace-with-random-token-at-least-32-characters
HEALTHOS_AUDIT_HMAC_KEY=replace-with-random-token-at-least-32-characters
HEALTHOS_BLOB_KEY_B64=replace-with-url-safe-base64-of-32-random-bytes
HEALTHOS_BACKUP_KEY_B64=replace-with-different-url-safe-base64-of-32-random-bytes
HEALTHOS_BLOB_DIRECTORY=.healthos-blobs

HEALTHOS_ACCESS_TOKEN_MINUTES=15
HEALTHOS_CHALLENGE_TTL_SECONDS=300
HEALTHOS_MAX_REQUEST_BODY_BYTES=2097152
HEALTHOS_EXTERNAL_LLM_ENABLED=false
HEALTHOS_LOG_LEVEL=INFO
